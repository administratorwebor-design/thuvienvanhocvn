PORT=4000
# Choose sqlite for isolated offline development or supabase for shared persistent data.
DATABASE_DRIVER=sqlite
SUPABASE_DATABASE_URL=
# Path to the certificate downloaded from the project's Database / SSL settings.
SUPABASE_CA_CERT_PATH=
REQUIRE_EXISTING_DATA=false
CLASSROOMS_ENABLED=true
APP_URL=http://127.0.0.1:4000
PUBLIC_BASE_URL=
FRONTEND_ORIGIN=http://127.0.0.1:4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
# Required only when creating the first administrator.
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Email: configure SMTP for actual delivery. Use MAIL_TRANSPORT=file only in local development.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
