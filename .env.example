PORT=4000
APP_URL=http://127.0.0.1:4000
PUBLIC_BASE_URL=
FRONTEND_ORIGIN=http://127.0.0.1:4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
# Required only when creating the first administrator.
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Email: configure SMTP for actual delivery. Use MAIL_TRANSPORT=file only in local development.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
